        <mxCell id="70" value="allow view /&lt;br&gt;control" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1323" y="286" width="74" height="28" as="geometry" />
        </mxCell>
        <mxCell id="71" value="Every process runs on every device, except 9.0 (AI device only). Processes 2.0 to 8.0 also exchange data with the same process on the&lt;br&gt;user's other trusted devices, through the communication layer and only after 1.0 has checked trust (not drawn, to keep the diagram readable)." style="html=1;whiteSpace=wrap;fontSize=9;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="1360" height="50" as="geometry" />
