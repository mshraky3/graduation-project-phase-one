<mxfile host="app.diagrams.net"><diagram id="c9seq" name="C9 screen sharing session"><mxGraphModel dx="1430" dy="1078" grid="1" gridSize="10" guides="1" page="1" pageWidth="1430" pageHeight="1078" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="C9 Screen sharing: one session with control (laptop views and controls a Windows PC)" style="text;html=0;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1430" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Laptop (viewer)" style="rounded=1;arcSize=2;fillColor=#eef4fb;strokeColor=#9fb9d8;verticalAlign=top;fontSize=12;fontColor=#335555;" vertex="1" parent="1"><mxGeometry x="15" y="52" width="585" height="998" as="geometry"/></mxCell><mxCell id="c5" value="Windows PC (shared device)" style="rounded=1;arcSize=2;fillColor=#eefaf0;strokeColor=#9fd8a9;verticalAlign=top;fontSize=12;fontColor=#335533;" vertex="1" parent="1"><mxGeometry x="625" y="52" width="790" height="998" as="geometry"/></mxCell><mxCell id="c6" value="User (laptop)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="126" as="sourcePoint"/><mxPoint x="110" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="Screen-share module (C9)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="126" as="sourcePoint"/><mxPoint x="300" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="Core services +&#xa;communication layer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="126" as="sourcePoint"/><mxPoint x="490" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Core services +&#xa;communication layer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="126" as="sourcePoint"/><mxPoint x="760" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="Screen-share module (C9)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="865" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="126" as="sourcePoint"/><mxPoint x="950" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="Windows (picker,&#xa;capture, SendInput)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1055" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="126" as="sourcePoint"/><mxPoint x="1140" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="User (PC)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1245" y="76" width="170" height="44" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="126" as="sourcePoint"/><mxPoint x="1330" y="1044" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="1. View screen of PC (view + control)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="170" as="sourcePoint"/><mxPoint x="300" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="2. PC trusted, online, can be viewed/controlled, sharing on?" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="216" as="sourcePoint"/><mxPoint x="490" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="3. Yes" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="262" as="sourcePoint"/><mxPoint x="300" y="262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="4. Request {session id, view + control} (TLS, messages connection)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="308" as="sourcePoint"/><mxPoint x="760" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="" style="endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="344" as="sourcePoint"/><mxPoint x="760" y="362" as="targetPoint"/><Array as="points"><mxPoint x="800" y="344"/><mxPoint x="800" y="362"/></Array></mxGeometry></mxCell><mxCell id="c25" value="5. Checks: laptop is trusted, screen sharing is on for it (C11)" style="text;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="806" y="346" width="560" height="16" as="geometry"/></mxCell><mxCell id="c26" value="6. Incoming request" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="400" as="sourcePoint"/><mxPoint x="950" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="7. &quot;Laptop wants to see your screen: Allow view / Allow view and control / Deny&quot;" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="446" as="sourcePoint"/><mxPoint x="1330" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="8. Allow view and control" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="492" as="sourcePoint"/><mxPoint x="950" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="9. Open system picker (GraphicsCapturePicker); user picks the screen" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="538" as="sourcePoint"/><mxPoint x="1140" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="10. Capture starts; yellow border; our bar &quot;Controlled by Laptop&quot; + Stop" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="584" as="sourcePoint"/><mxPoint x="950" y="584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="11. Accepted + WebRTC offer (DTLS fingerprint, local candidates only)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="630" as="sourcePoint"/><mxPoint x="490" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="12. WebRTC answer (DTLS fingerprint, local candidates)" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="676" as="sourcePoint"/><mxPoint x="760" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="13. WebRTC direct: fingerprints checked, video (DTLS-SRTP, UDP, no server)" style="endArrow=block;endFill=1;strokeColor=#1f6fb2;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="722" as="sourcePoint"/><mxPoint x="300" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="14. Shows the PC screen" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="768" as="sourcePoint"/><mxPoint x="110" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="15. Moves mouse, types" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="814" as="sourcePoint"/><mxPoint x="300" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="16. Data channel: input events; module checks control allowed, then SendInput" style="endArrow=block;endFill=1;strokeColor=#1f6fb2;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="860" as="sourcePoint"/><mxPoint x="950" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="17. Taps Stop" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="906" as="sourcePoint"/><mxPoint x="950" y="906" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="18. Capture and WebRTC stopped; &quot;stopped&quot;; laptop shows &quot;Session ended&quot;" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="952" as="sourcePoint"/><mxPoint x="490" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="Solid arrow = request or message. Dashed arrow = answer. Thick blue arrow = WebRTC media and data channel, directly between the devices. Messages steps 4, 11, 12, 18 use the trusted TLS connection (C1). Not drawn: Deny at step 8 ends here; the viewer can also Stop; connection lost ends the session (section 4)." style="text;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1052" width="1390" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
