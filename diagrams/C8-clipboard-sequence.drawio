" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Operating system (clipboard)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1205.0" y="76" width="160" height="44" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285.0" y="126" as="sourcePoint"/><mxPoint x="1285.0" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="1. Copies text (Ctrl+C) on the sending device" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="178" as="sourcePoint"/><mxPoint x="335.0" y="178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="2. Clipboard changed (WM_CLIPBOARDUPDATE)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335.0" y="226" as="sourcePoint"/><mxPoint x="525.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="" style="endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525.0" y="262" as="sourcePoint"/><mxPoint x="525.0" y="280" as="targetPoint"/><Array as="points"><mxPoint x="565.0" y="262"/><mxPoint x="565.0" y="280"/></Array></mxGeometry></mxCell><mxCell id="c23" value="3. Checks: feature on, not paused, not secret,&#xa;not a received item, 1 MB or less" style="text;align=left;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="571.0" y="256" width="230" height="32" as="geometry"/></mxCell><mxCell id="c24" value="4. Which paired devices are online with clipboard receiving on?" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525.0" y="322" as="sourcePoint"/><mxPoint x="715.0" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="5. The receiving device" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715.0" y="370" as="sourcePoint"/><mxPoint x="525.0" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="6. Clipboard item {item id, sending device id, text}" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525.0" y="418" as="sourcePoint"/><mxPoint x="715.0" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="7. Item sent encrypted (TLS, messages channel)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715.0" y="466" as="sourcePoint"/><mxPoint x="905.0" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="502" as="sourcePoint"/><mxPoint x="905.0" y="520" as="targetPoint"/><Array as="points"><mxPoint x="945.0" y="502"/><mxPoint x="945.0" y="520"/></Array></mxGeometry></mxCell><mxCell id="c29" value="8. Checks: sender is paired, receiving from it is on" style="text;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="951.0" y="504" width="420" height="16" as="geometry"/></mxCell><mxCell id="c30" value="9. Clipboard item" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="562" as="sourcePoint"/><mxPoint x="1095.0" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="10. Puts the text on the clipboard (marked: from the sending device)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095.0" y="610" as="sourcePoint"/><mxPoint x="1285.0" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="11. Done" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095.0" y="658" as="sourcePoint"/><mxPoint x="905.0" y="658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="12. Received" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="706" as="sourcePoint"/><mxPoint x="715.0" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="13. Pastes (Ctrl+V) on the receiving device" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="754" as="sourcePoint"/><mxPoint x="1285.0" y="754" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="14. Clipboard changed: item from another device, not sent again" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285.0" y="802" as="sourcePoint"/><mxPoint x="1095.0" y="802" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="Solid arrow = request or message. Dashed arrow = answer. Images, and items from phones and tablets, start from a tap on &quot;Send&quot; instead of step 2." style="text;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="874" width="1330" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
