" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525.0" y="322" as="sourcePoint"/><mxPoint x="715.0" y="322" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="5. Device B" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715.0" y="370" as="sourcePoint"/><mxPoint x="525.0" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="6. Clipboard item {item id, origin = A, text}" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="525.0" y="418" as="sourcePoint"/><mxPoint x="715.0" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="7. Item sent encrypted (TLS, messages channel)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="715.0" y="466" as="sourcePoint"/><mxPoint x="905.0" y="466" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=block;endFill=1;rounded=0;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="502" as="sourcePoint"/><mxPoint x="905.0" y="520" as="targetPoint"/><Array as="points"><mxPoint x="945.0" y="502"/><mxPoint x="945.0" y="520"/></Array></mxGeometry></mxCell><mxCell id="c29" value="8. Checks: sender A is trusted, receiving from A is on" style="text;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="951.0" y="504" width="420" height="16" as="geometry"/></mxCell><mxCell id="c30" value="9. Clipboard item" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="562" as="sourcePoint"/><mxPoint x="1095.0" y="562" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="10. Puts the text on the clipboard (marked: from A)" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095.0" y="610" as="sourcePoint"/><mxPoint x="1285.0" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="11. Done" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1095.0" y="658" as="sourcePoint"/><mxPoint x="905.0" y="658" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="12. Received by B" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905.0" y="706" as="sourcePoint"/><mxPoint x="715.0" y="706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="13. Pastes (Ctrl+V) on Device B" style="endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="754" as="sourcePoint"/><mxPoint x="1285.0" y="754" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="14. Clipboard changed: item came from A, so it is not sent again" style="endArrow=open;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;html=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285.0" y="802" as="sourcePoint"/><mxPoint x="1095.0" y="802" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="Solid arrow = request or message. Dashed arrow = answer. Images, and phones/tablets, start from a &quot;Send&quot; tap instead of step 2 (see section 2)." style="text;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="50" y="874" width="1330" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
