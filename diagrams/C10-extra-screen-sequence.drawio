></mxCell><mxCell id="c10" value="Core services +&#xa;communication layer (laptop)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565.0" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="126" as="sourcePoint"/><mxPoint x="665" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="C10 module (laptop)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820.0" y="80" width="170" height="46" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="126" as="sourcePoint"/><mxPoint x="905" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="Display driver (IDD)&#xa;+ Windows" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1045.0" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="126" as="sourcePoint"/><mxPoint x="1145" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="1. Taps &quot;Use as extra screen&quot;" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="170" as="sourcePoint"/><mxPoint x="335" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="2. Request (screen size 2048x1536) over trusted TLS messages connection" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="216" as="sourcePoint"/><mxPoint x="665" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="3. Trust + C10 check; user confirms on laptop (Deny: stop)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="495" y="248" width="340" height="28" as="geometry"/></mxCell><mxCell id="c19" value="4. Start extra screen" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="308" as="sourcePoint"/><mxPoint x="905" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="5. Add virtual screen 2048x1536" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="354" as="sourcePoint"/><mxPoint x="1145" y="354" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="   New screen ready" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="400" as="sourcePoint"/><mxPoint x="905" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="6. WebRTC offer + DTLS fingerprint (over messages connection)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="446" as="sourcePoint"/><mxPoint x="335" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. WebRTC answer; direct video + data channel open (no STUN/TURN)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="492" as="sourcePoint"/><mxPoint x="905" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="8. Live frames of the new screen (continuous, low delay)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="538" as="sourcePoint"/><mxPoint x="335" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="9. Touch on iPad" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="584" as="sourcePoint"/><mxPoint x="335" y="584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="10. Touch as absolute position (data channel)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="630" as="sourcePoint"/><mxPoint x="905" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="10b. Mouse move / click on extra screen only" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="676" as="sourcePoint"/><mxPoint x="1145" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="11. Taps Stop (or leaves the app)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="722" as="sourcePoint"/><mxPoint x="335" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="12. Stop: stream closes" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="768" as="sourcePoint"/><mxPoint x="905" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="13. Remove virtual screen; windows move back" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="814" as="sourcePoint"/><mxPoint x="1145" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Same steps for an Android tablet. Linux on Wayland: step 5 is the portal dialog (VIRTUAL source). macOS, X11: no virtual screen, mirror instead (section 4)." style="text;html=0;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>