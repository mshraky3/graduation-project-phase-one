<mxfile host="app.diagrams.net"><diagram id="c10seq" name="Extra Screen"><mxGraphModel dx="1430" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1430" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Extra Screen: start, use and stop, with an iPad as the extra screen of a Windows laptop" style="text;html=0;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1430" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Screen device (iPad)" style="rounded=1;arcSize=2;fillColor=#eef4fb;strokeColor=#9fb9d8;verticalAlign=top;fontSize=12;fontColor=#335555;" vertex="1" parent="1"><mxGeometry x="50" y="52" width="510" height="830" as="geometry"/></mxCell><mxCell id="c5" value="Host device (Windows laptop with the tool's driver)" style="rounded=1;arcSize=2;fillColor=#eefaf0;strokeColor=#9fd8a9;verticalAlign=top;fontSize=12;fontColor=#335555;" vertex="1" parent="1"><mxGeometry x="570" y="52" width="806" height="830" as="geometry"/></mxCell><mxCell id="c6" value="User" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60.0" y="80" width="170" height="46" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="126" as="sourcePoint"/><mxPoint x="145" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="Feature module (iPad)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250.0" y="80" width="170" height="46" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="126" as="sourcePoint"/><mxPoint x="335" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="Core services and&#xa;Communication layer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="565.0" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="126" as="sourcePoint"/><mxPoint x="665" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Feature module" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820.0" y="80" width="170" height="46" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="126" as="sourcePoint"/><mxPoint x="905" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="Operating system&#xa;(Windows and display driver)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1045.0" y="80" width="200" height="46" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="126" as="sourcePoint"/><mxPoint x="1145" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="1. Taps &quot;Use as extra screen&quot;" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="170" as="sourcePoint"/><mxPoint x="335" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="2. Request (screen size 2048 × 1536) over the trusted TLS messages connection" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="216" as="sourcePoint"/><mxPoint x="665" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="3. Pairing and permission check; the user confirms on the laptop (&quot;Deny&quot;: stop)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="495" y="248" width="340" height="28" as="geometry"/></mxCell><mxCell id="c19" value="4. Start extra screen" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="308" as="sourcePoint"/><mxPoint x="905" y="308" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="5. Adds a virtual screen of 2048 × 1536" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="354" as="sourcePoint"/><mxPoint x="1145" y="354" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="   New screen ready" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1145" y="400" as="sourcePoint"/><mxPoint x="905" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="6. WebRTC offer + DTLS fingerprint (over messages connection)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="446" as="sourcePoint"/><mxPoint x="335" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="7. WebRTC answer; direct video + data channel open (no STUN/TURN)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;fontColor=#222222;labelBackgroundColor=#ffffff;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="492" as="sourcePoint"/><mxPoint x="905" y="492" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="8. Live frames of the new screen (continuous, low delay)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="538" as="sourcePoint"/><mxPoint x="335" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="9. Touch on iPad" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="584" as="sourcePoint"/><mxPoint x="335" y="584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="10. Touch as absolute position (data channel)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="630" as="sourcePoint"/><mxPoint x="905" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="10b. Mouse movement or click on the extra screen only" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="676" as="sourcePoint"/><mxPoint x="1145" y="676" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="11. Taps &quot;Stop&quot; (or leaves the app)" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="722" as="sourcePoint"/><mxPoint x="335" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="12. Stop: stream closes" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="768" as="sourcePoint"/><mxPoint x="905" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="13. Removes the virtual screen; windows move back" style="endArrow=block;endFill=1;fontSize=11;strokeColor=#1f4e79;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="905" y="814" as="sourcePoint"/><mxPoint x="1145" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Same steps for an Android tablet. Linux with Wayland: step 5 is the system portal dialog. macOS and Linux with X11: no virtual screen is added; the existing screen is mirrored." style="text;html=0;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1300" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>